<button id="open-settings" type="button"
  class="text-sm text-[var(--ink-muted)] underline">Settings</button>

<dialog id="settings" class="rounded border border-[var(--line)] bg-[var(--surface)] p-6 text-[var(--ink)]">
  <h2 class="text-lg font-semibold">Settings</h2>

  <div class="mt-4">
    <span class="text-sm font-medium">Theme</span>
    <div class="mt-1 flex gap-4">
      <label class="flex items-center gap-1"><input type="radio" name="theme" data-setting="theme" value="system" /> System</label>
      <label class="flex items-center gap-1"><input type="radio" name="theme" data-setting="theme" value="light" /> Light</label>
      <label class="flex items-center gap-1"><input type="radio" name="theme" data-setting="theme" value="dark" /> Dark</label>
    </div>
  </div>

  <div class="mt-4">
    <span class="text-sm font-medium">yt-dlp updates</span>
    <div class="mt-1 flex gap-4">
      <label class="flex items-center gap-1"><input type="radio" name="update-channel" data-setting="update-channel" value="stable" /> Stable</label>
      <label class="flex items-center gap-1"><input type="radio" name="update-channel" data-setting="update-channel" value="nightly" /> Nightly</label>
      <label class="flex items-center gap-1"><input type="radio" name="update-channel" data-setting="update-channel" value="master" /> Master</label>
    </div>
    <p id="version" class="mt-1 text-xs text-[var(--ink-muted)]"></p>
    <button id="update-now" type="button" class="mt-1 rounded border border-[var(--line)] px-3 py-1 text-sm">Check for updates</button>
  </div>

  <div class="mt-4">
    <span class="text-sm font-medium">Settings file</span>
    <p id="config-path" class="mt-1 truncate font-mono text-xs text-[var(--ink-muted)]"></p>
    <button id="open-config" type="button" class="mt-1 rounded border border-[var(--line)] px-3 py-1 text-sm">Open</button>
  </div>

  <button id="close-settings" type="button" class="mt-6 rounded bg-[var(--ink)] px-4 py-2 text-[var(--surface)]">Close</button>
</dialog>
