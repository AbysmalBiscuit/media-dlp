<button id="open-settings" type="button" class="btn btn-quiet">Settings</button>

<dialog id="settings" class="dialog p-6">
  <h2 class="text-lg font-semibold">Settings</h2>

  <fieldset class="card mt-4">
    <legend class="card-title">Theme</legend>
    <div class="option-grid mt-2">
      <label class="option"><input type="radio" name="theme" data-setting="theme" value="system" /> <span>System</span></label>
      <label class="option"><input type="radio" name="theme" data-setting="theme" value="light" /> <span>Light</span></label>
      <label class="option"><input type="radio" name="theme" data-setting="theme" value="dark" /> <span>Dark</span></label>
    </div>
  </fieldset>

  <fieldset class="card mt-4">
    <legend class="card-title">yt-dlp updates</legend>
    <div class="option-grid mt-2">
      <label class="option"><input type="radio" name="update-channel" data-setting="update-channel" value="stable" /> <span>Stable</span></label>
      <label class="option"><input type="radio" name="update-channel" data-setting="update-channel" value="nightly" /> <span>Nightly</span></label>
      <label class="option"><input type="radio" name="update-channel" data-setting="update-channel" value="master" /> <span>Master</span></label>
    </div>
    <p id="version" class="note mt-3"></p>
    <button id="update-now" type="button" class="btn btn-quiet mt-3">Check for updates</button>
  </fieldset>

  <div class="mt-4">
    <span class="field-label">Settings file</span>
    <p id="config-path" class="note mt-2 truncate font-mono"></p>
    <button id="open-config" type="button" class="btn btn-quiet mt-3">Open</button>
  </div>

  <button id="close-settings" type="button" class="btn btn-secondary mt-6 w-full">Close</button>
</dialog>
