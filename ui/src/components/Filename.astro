<section>
  <span class="field-label">File name</span>
  <div class="option-grid mt-2">
    <label class="option"><input type="checkbox" data-filename="channel" /> <span>Channel</span></label>
    <label class="option"><input type="checkbox" data-filename="upload-date" /> <span>Upload date</span></label>
    <label class="option"><input type="checkbox" data-filename="playlist-number" /> <span>Playlist number</span></label>
    <label class="option"><input type="checkbox" data-filename="video-id" /> <span>Video ID</span></label>
    <label class="option"><input type="checkbox" checked disabled /> <span>Title</span></label>
  </div>

  <span class="field-label mt-4">Separator</span>
  <div class="option-grid mt-2">
    <label class="option"><input type="radio" name="separator" data-separator value="dash" /> <span>Dash</span></label>
    <label class="option"><input type="radio" name="separator" data-separator value="underscore" /> <span>Underscore</span></label>
    <label class="option"><input type="radio" name="separator" data-separator value="space" /> <span>Space</span></label>
  </div>

  <p id="filename-preview" class="mt-4 truncate rounded-lg bg-[var(--surface-muted)] px-3 py-2 font-mono text-sm"></p>
</section>
