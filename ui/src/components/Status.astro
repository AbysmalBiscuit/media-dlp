<section class="space-y-3">
  <div id="probe-card" hidden class="flex gap-3 rounded border border-neutral-200 p-3">
    <img id="probe-thumb" alt="" class="h-16 w-28 rounded object-cover" />
    <div class="min-w-0">
      <p id="probe-title" class="truncate font-medium"></p>
      <p id="probe-sub" class="text-xs text-neutral-500"></p>
    </div>
  </div>

  <button id="download" type="button"
    class="w-full rounded bg-neutral-900 px-4 py-3 text-white disabled:bg-neutral-300">
    Download
  </button>

  <div id="progress-area" hidden class="space-y-2">
    <div class="h-2 w-full overflow-hidden rounded bg-neutral-200">
      <div id="progress-bar" class="h-full w-0 bg-neutral-900 transition-[width]"></div>
    </div>
    <p id="progress-text" class="text-xs text-neutral-500"></p>
    <button id="cancel" type="button" class="rounded border px-3 py-1 text-sm">Cancel</button>
  </div>

  <div id="result" hidden class="rounded border border-neutral-200 p-3">
    <p id="result-message" class="text-sm"></p>
    <button id="open-folder" type="button" hidden
      class="mt-2 rounded border px-3 py-1 text-sm">Open folder</button>
    <details id="result-details" hidden class="mt-2">
      <summary class="cursor-pointer text-xs text-neutral-500">Show details</summary>
      <pre id="result-log" class="mt-1 max-h-40 overflow-auto rounded bg-neutral-100 p-2 text-xs"></pre>
      <button id="copy-log" type="button" class="mt-1 rounded border px-2 py-1 text-xs">Copy</button>
    </details>
  </div>
</section>
