---
import Controls from '../components/Controls.astro';
import Filename from '../components/Filename.astro';
import SettingsPanel from '../components/SettingsPanel.astro';
import Status from '../components/Status.astro';
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>media-dlp</title>
  </head>
  <body class="bg-[var(--surface)] text-[var(--ink)]">
    <main class="mx-auto flex max-w-xl flex-col gap-6 px-5 py-6">
      <header class="flex items-center justify-between gap-4">
        <h1 class="text-xl font-semibold">media-dlp</h1>
        <SettingsPanel />
      </header>
      <Controls />
      <div class="card">
        <Filename />
      </div>
      <Status />
    </main>

    <script>
      import { listen } from '@tauri-apps/api/event';
      import { open } from '@tauri-apps/plugin-dialog';
      import { openPath, revealItemInDir } from '@tauri-apps/plugin-opener';
      import {
        browserSupport,
        cancel,
        checkForUpdates,
        configPath,
        cookieCheck,
        download,
        getSettings,
        probe,
        saveSettings,
        ytdlpVersion,
      } from '../lib/api';
      import { BROWSER_LABELS, cookieWarning } from '../lib/cookies';
      import { previewFilename } from '../lib/filename';
      import type {
        DownloadFailed,
        DownloadFinished,
        FilenameSettings,
        Progress,
        ProbeInfo,
        Separator,
        Settings,
      } from '../lib/types';

      const settings: Settings = await getSettings();

      const applyTheme = () => {
        const root = document.documentElement;
        if (settings.theme === 'system') root.removeAttribute('data-theme');
        else root.setAttribute('data-theme', settings.theme);
      };

      let probed: ProbeInfo | null = null;

      // A disabled <fieldset> disables its inputs natively, so the options keep
      // their place in the layout instead of the page reflowing on every toggle.
      const setGroupEnabled = (id: string, enabled: boolean) => {
        const container = document.getElementById(id)!;
        container.classList.toggle('is-off', !enabled);
        for (const group of container.querySelectorAll('fieldset')) group.disabled = !enabled;
      };

      const applyAudioOnly = () => {
        setGroupEnabled('video-groups', !settings['audio-only']);
        setGroupEnabled('audio-groups', settings['audio-only']);
      };

      const extension = () =>
        settings['audio-only'] ? settings['audio-format'] : settings['video-format'];

      const refreshPreview = () => {
        document.getElementById('filename-preview')!.textContent =
          previewFilename(settings.filename, probed, extension());
      };

      const apply = () => {
        for (const input of document.querySelectorAll<HTMLInputElement>('[data-setting]')) {
          const key = input.dataset.setting as keyof Settings;
          if (input.type === 'checkbox') input.checked = Boolean(settings[key]);
          else input.checked = (settings[key] ?? 'none') === input.value;
        }
        (document.getElementById('folder') as HTMLInputElement).value =
          settings['save-folder'] ?? '';
        applyAudioOnly();
      };

      document.addEventListener('change', async (event) => {
        const input = event.target as HTMLInputElement;
        switch (input.dataset.setting) {
          case 'audio-only':
            settings['audio-only'] = input.checked;
            break;
          case 'video-quality': {
            const { value } = input;
            if (value === 'best' || value === '1080p' || value === '720p' || value === '480p') {
              settings['video-quality'] = value;
            }
            break;
          }
          case 'video-format': {
            const { value } = input;
            if (value === 'mp4' || value === 'mkv' || value === 'webm') {
              settings['video-format'] = value;
            }
            break;
          }
          case 'audio-format': {
            const { value } = input;
            if (value === 'mp3' || value === 'm4a' || value === 'opus' || value === 'wav') {
              settings['audio-format'] = value;
            }
            break;
          }
          case 'audio-quality': {
            const { value } = input;
            if (value === 'best' || value === 'good' || value === 'smaller') {
              settings['audio-quality'] = value;
            }
            break;
          }
          case 'cookie-browser': {
            const { value } = input;
            if (value === 'none') settings['cookie-browser'] = null;
            else if (value === 'chrome' || value === 'firefox') settings['cookie-browser'] = value;
            break;
          }
          case 'theme': {
            const { value } = input;
            if (value === 'system' || value === 'light' || value === 'dark') {
              settings.theme = value;
            }
            break;
          }
          case 'update-channel': {
            const { value } = input;
            if (value === 'stable' || value === 'nightly' || value === 'master') {
              settings['update-channel'] = value;
            }
            break;
          }
          default:
            return;
        }
        applyAudioOnly();
        await saveSettings(settings);
      });

      document.getElementById('browse')!.addEventListener('click', async () => {
        const picked = await open({ directory: true, multiple: false });
        if (typeof picked !== 'string') return;
        settings['save-folder'] = picked;
        (document.getElementById('folder') as HTMLInputElement).value = picked;
        await saveSettings(settings);
      });

      for (const box of document.querySelectorAll<HTMLInputElement>('[data-filename]')) {
        box.checked = Boolean(settings.filename[box.dataset.filename as keyof FilenameSettings]);
        box.addEventListener('change', async () => {
          const key = box.dataset.filename as
            | 'channel'
            | 'upload-date'
            | 'playlist-number'
            | 'video-id';
          settings.filename[key] = box.checked;
          refreshPreview();
          await saveSettings(settings);
        });
      }

      for (const radio of document.querySelectorAll<HTMLInputElement>('[data-separator]')) {
        radio.checked = settings.filename.separator === radio.value;
        radio.addEventListener('change', async () => {
          settings.filename.separator = radio.value as Separator;
          refreshPreview();
          await saveSettings(settings);
        });
      }

      document.addEventListener('change', refreshPreview);

      // Everything the window shows on launch comes from settings, so it is
      // painted here rather than after the yt-dlp version lookup and the event
      // registrations below. Those take a round trip each, and until they
      // returned the window sat with nothing chosen and no save folder.
      apply();
      refreshPreview();
      applyTheme();

      const group = document.getElementById('cookie-group')!;
      const note = document.getElementById('cookie-note')!;

      const cookieOption = (value: string, text: string, disabled: boolean): HTMLLabelElement => {
        const label = document.createElement('label');
        label.className = 'option';
        const radio = document.createElement('input');
        radio.type = 'radio';
        radio.name = 'cookie-browser';
        radio.dataset.setting = 'cookie-browser';
        radio.value = value;
        radio.disabled = disabled;
        radio.checked = (settings['cookie-browser'] ?? 'none') === value;
        label.append(radio, ` ${text}`);
        return label;
      };

      const support = await browserSupport();
      group.append(cookieOption('none', 'None', false));
      for (const { browser, supported, reason } of support) {
        group.append(cookieOption(browser, BROWSER_LABELS[browser], !supported));
        if (reason) note.textContent = reason;
      }

      // A browser the app will not let the user select is never checked: cookie
      // presence needs no decryption, so an unsupported browser answers
      // `present` for a site whose download would still fail.
      const selectable = new Set(support.filter((s) => s.supported).map((s) => s.browser));

      const dialog = document.getElementById('settings') as HTMLDialogElement;
      document.getElementById('open-settings')!.addEventListener('click', () => dialog.showModal());
      document.getElementById('close-settings')!.addEventListener('click', () => dialog.close());

      const path = await configPath();
      document.getElementById('config-path')!.textContent = path;
      document.getElementById('open-config')!.addEventListener('click', () => openPath(path));

      const version = document.getElementById('version')!;
      const showVersion = async () => {
        try {
          version.textContent = `yt-dlp ${await ytdlpVersion()}`;
        } catch {
          version.textContent = "Couldn't read the yt-dlp version.";
        }
      };
      await showVersion();
      document.getElementById('update-now')!.addEventListener('click', async () => {
        version.textContent = 'Checking...';
        try {
          await checkForUpdates(settings['update-channel']);
          await showVersion();
        } catch {
          version.textContent = "Couldn't check for updates.";
        }
      });

      document.addEventListener('change', applyTheme);

      const button = document.getElementById('download') as HTMLButtonElement;
      const area = document.getElementById('progress-area')!;
      const bar = document.getElementById('progress-bar') as HTMLElement;
      const text = document.getElementById('progress-text')!;
      const result = document.getElementById('result')!;
      const resultMessage = document.getElementById('result-message')!;
      const details = document.getElementById('result-details') as HTMLDetailsElement;
      const log = document.getElementById('result-log')!;
      const openButton = document.getElementById('open-folder') as HTMLButtonElement;
      const cancelButton = document.getElementById('cancel') as HTMLButtonElement;
      let lastFile = '';

      const showResult = (message: string, showDetails = false, showOpenFolder = false) => {
        area.hidden = true;
        button.disabled = false;
        resultMessage.textContent = message;
        details.hidden = !showDetails;
        openButton.hidden = !showOpenFolder;
        result.hidden = false;
      };

      // A probe only previews what a URL would download; it must never hide the
      // progress area or re-enable the Download button for a transfer in flight.
      const showProbeError = (message: string) => {
        resultMessage.textContent = message;
        details.hidden = true;
        openButton.hidden = true;
        result.hidden = false;
      };

      const urlInput = document.getElementById('url') as HTMLInputElement;
      const card = document.getElementById('probe-card')!;
      const warning = document.getElementById('cookie-warning')!;
      let probeTimer: ReturnType<typeof setTimeout> | undefined;

      const runCookieCheck = async (url: string) => {
        warning.textContent = '';
        const browser = settings['cookie-browser'];
        if (!url || !browser || !selectable.has(browser)) return;
        try {
          const checked = await cookieCheck(url, browser);
          const message = cookieWarning(
            checked,
            { url, browser },
            { url: urlInput.value.trim(), browser: settings['cookie-browser'] },
          );
          if (message) warning.textContent = message;
        } catch {
          // A command that would not run is an unknown answer, which says nothing.
        }
      };

      // Registered after the listener that writes the radio into `settings`, so
      // the check reads the browser the user just picked.
      document.addEventListener('change', (event) => {
        const input = event.target as HTMLInputElement;
        if (input.dataset.setting === 'cookie-browser') runCookieCheck(urlInput.value.trim());
      });

      urlInput.addEventListener('input', () => {
        result.hidden = true;
        warning.textContent = '';
        clearTimeout(probeTimer);
        probeTimer = setTimeout(async () => {
          const url = urlInput.value.trim();
          runCookieCheck(url);
          if (!url) {
            probed = null;
            card.hidden = true;
            refreshPreview();
            return;
          }
          // A probe cannot be cancelled once it has started, so a slow answer
          // about a link the user has replaced can land after a fast answer
          // about the current one. Either way round, an answer that no longer
          // matches the box describes something the user is no longer looking
          // at, and belongs nowhere on screen.
          const stale = () => urlInput.value.trim() !== url;
          try {
            const info = await probe(url);
            if (stale()) return;
            probed = info;
            (document.getElementById('probe-title') as HTMLElement).textContent = info.title;
            (document.getElementById('probe-sub') as HTMLElement).textContent = info.playlistCount
              ? `${info.uploader ?? 'Unknown channel'} - playlist of ${info.playlistCount}`
              : (info.uploader ?? '');
            const thumb = document.getElementById('probe-thumb') as HTMLImageElement;
            thumb.src = info.thumbnail ?? '';
            thumb.hidden = !info.thumbnail;
            card.hidden = false;
          } catch {
            if (stale()) return;
            probed = null;
            card.hidden = true;
            showProbeError('That link could not be read.');
          }
          refreshPreview();
        }, 400);
      });

      button.addEventListener('click', async () => {
        const folder = settings['save-folder'];
        if (!folder) {
          showResult('Choose a folder to save into first.');
          return;
        }
        result.hidden = true;
        area.hidden = false;
        button.disabled = true;
        bar.style.width = '0%';
        text.textContent = 'Starting';
        try {
          await download(settings, folder, urlInput.value.trim());
        } catch (error) {
          log.textContent = typeof error === 'string' ? error : String(error);
          showResult('That download did not start.', true);
        }
      });

      cancelButton.addEventListener('click', async () => {
        const folder = settings['save-folder'];
        if (!folder) return;
        cancelButton.disabled = true;
        try {
          await cancel(folder);
        } catch {
          // Cleanup may be incomplete, but the UI still needs to unstick.
        }
        cancelButton.disabled = false;
        showResult('Cancelled.');
      });

      await listen<Progress>('download-progress', ({ payload }) => {
        const done = payload.downloadedBytes ?? 0;
        const total = payload.totalBytes ?? 0;
        const percent = total ? Math.min(100, Math.round((done / total) * 100)) : 0;
        bar.style.width = `${percent}%`;
        const position =
          payload.playlistCount && payload.playlistIndex
            ? `video ${payload.playlistIndex} of ${payload.playlistCount}: `
            : '';
        text.textContent = `${position}${payload.title ?? ''}`;
      });

      await listen<DownloadFinished>('download-finished', ({ payload }) => {
        lastFile = payload.file;
        showResult('Done.', false, Boolean(lastFile));
      });

      await listen<DownloadFailed>('download-failed', ({ payload }) => {
        log.textContent = payload.details;
        showResult(payload.message, true);
      });

      openButton.addEventListener('click', () => {
        if (lastFile) revealItemInDir(lastFile);
      });

      document.getElementById('copy-log')!.addEventListener('click', () => {
        navigator.clipboard.writeText(log.textContent ?? '');
      });
    </script>
  </body>
</html>
