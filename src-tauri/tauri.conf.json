{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "media-dlp",
  "version": "0.1.0",
  "identifier": "dev.abysmalbiscuit.media-dlp",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run --cwd ../ui dev",
    "beforeBuildCommand": "bun run --cwd ../ui build"
  },
  "app": {
    "windows": [
      {
        "title": "media-dlp",
        "width": 620,
        "height": 780,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["binaries/*"],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
