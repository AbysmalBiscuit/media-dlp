{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "media-dlp",
  "version": "0.1.0",
  "identifier": "dev.abysmalbiscuit.media-dlp",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run --cwd ../ui dev",
    "beforeBuildCommand": "bun run --cwd ../ui build"
  },
  "app": {
    "windows": [
      {
        "title": "media-dlp",
        "width": 620,
        "height": 780,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["binaries/*"]
  }
}
